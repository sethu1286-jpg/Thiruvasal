rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == "admin";
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Users ────────────────────────────
    match /users/{uid} {
      allow read:   if isSignedIn() && (isOwner(uid) || isAdmin());
      allow create: if isSignedIn() && isOwner(uid);
      allow update: if isSignedIn() && (isOwner(uid) || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Donors ───────────────────────────
    match /donors/{donorId} {

      // Everyone logged in can view donors
      allow read: if isSignedIn();

      // Only admin can create
      allow create: if isAdmin();

      // ✅ FIX: Admin full control OR donor can update their own record (LIMITED)
      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.phone == resource.data.phone
          // Only allow status change (prevent tampering amount/name)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status"])
        );

      // Only admin delete
      allow delete: if isAdmin();
    }

    // ── Businesses ───────────────────────
    match /businesses/{businessId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn();

      allow update: if isSignedIn() &&
        (isAdmin() || resource.data.ownerId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // ── Reminders ────────────────────────
    match /reminders/{reminderId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
